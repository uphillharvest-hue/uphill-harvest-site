/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uphill-harvest-site",
	"compatibility_date": "2026-09-16",
	"main": "./workers/app.ts",
	"vars": {
		// Square location to sell from — safe to keep here (not secret).
		// This is currently Square's SANDBOX "Default Test Account" location
		// (for testing checkout end-to-end). Before going live, replace with
		// the real business Location ID from the Production tab of the
		// Square Developer Dashboard, and flip SQUARE_ENVIRONMENT below.
		"SQUARE_LOCATION_ID": "L4P7H4x55TWC",
		// "production" once real Square credentials are wired in, "sandbox" for testing.
		"SQUARE_ENVIRONMENT": "sandbox"
	},
	// SQUARE_ACCESS_TOKEN is a SECRET and must NOT go in this file.
	// Set it with: npx wrangler secret put SQUARE_ACCESS_TOKEN
	// (and add it as a local dev value in .dev.vars, which is gitignored)
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}